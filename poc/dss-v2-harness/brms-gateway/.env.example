# DSS V2 BRMS Gateway - Runtime configuration template
# Copy this file to .env and adjust for your environment.
# .env is gitignored - never commit it.

# --- Network / HTTP ---
PORT=11443
HTTPS=true
HTTPS_PORT=1443
HTTPS_PORT_2=9443
REALM=DSS-V2-LAB
PUBLIC_HOST=127.0.0.1

# --- Media / RTSP ---
RTSP_PORT=9100
MEDIAMTX_URL=rtsp://mediamtx:8554
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_CAMERA_PATH=cam1

# --- Services ---
ARS_PORT=9500
SIP_PORT=5080

# --- Device discovery tunables ---
E025_ONVIF_TIMEOUT_MS=2000
E025_EASY4IP_TIMEOUT_MS=2500
E025_COST_TIME_FLOOR_MS=20
